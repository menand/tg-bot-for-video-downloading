# Токен бота от @BotFather. Скопируй в .env и подставь свой токен.
# Файл .env не коммитится в git.

TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=0
# Скачивание только для этих Telegram ID (через запятую); пусто — для всех
# ALLOWED_USER_IDS=123456789,987654321
# Кастомный User-Agent для yt-dlp
# YT_DLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; rv:131.0) Gecko/20100101 Firefox/131.0
# BOT_DEBUG=1
